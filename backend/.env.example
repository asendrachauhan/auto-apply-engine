# ─── COPY THIS TO .env AND FILL IN YOUR VALUES ────────────────────────────────
# NEVER commit .env to Git — it is in .gitignore

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://your-frontend-domain.com

# ─── MongoDB Atlas (free at mongodb.com/atlas) ─────────────────────────────────
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.xxxxx.mongodb.net/autoapply?retryWrites=true&w=majority
  
# ─── JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_64_CHAR_RANDOM_HEX
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional — cron expression for the automatic application run. Defaults to every 6 hours.
CRON_SCHEDULE=0 */6 * * *

# Optional — cron expression for the GDPR account-erasure purge (accounts past
# their GDPR.DELETION_WINDOW_DAYS grace period). Defaults to daily at 3am.
PURGE_CRON_SCHEDULE=0 3 * * *

# ─── AI Model — swap providers/models entirely from here, no code changes ──────
# Free tier at console.groq.com. GROQ_MODEL accepts any model in Groq's catalog
# (e.g. llama3-8b-8192, llama-3.3-70b-versatile, mixtral-8x7b-32768).
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama3-8b-8192
# Optional — override to point at any other OpenAI-compatible endpoint/provider.
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# Optional — generation tuning (defaults shown)
GROQ_MAX_TOKENS=1000
GROQ_TEMPERATURE=0.3
GROQ_RETRIES=2
# Optional — cosmetic label only, shown via GET /api/config/ai
AI_PROVIDER_LABEL=Groq

# ─── Cloudinary — free at cloudinary.com ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Adzuna — free at developer.adzuna.com ─────────────────────────────────────
ADZUNA_APP_ID=your_app_id
ADZUNA_API_KEY=your_api_key
ADZUNA_COUNTRY=in

# ─── Google Jobs via SerpAPI — free tier at serpapi.com (optional source) ──────
# SERPAPI_KEY=your_serpapi_key
# How long (seconds) Google Jobs results are cached per (title, location)
# before re-querying. Default 1800 (30 min). Matters more than it looks —
# the real-time job watcher runs every ~120s per active user by default, so
# without this cache a single user could burn SerpAPI's whole 250/month
# free quota in about 8 hours (fixed Session 36, 2026-08-22).
# SERPAPI_CACHE_TTL_SECONDS=1800

# ─── LinkedIn/Naukri via Techmap's Job Postings API — RapidAPI (optional,
# paid-plan-only source) ────────────────────────────────────────────────────
# Session 39 (2026-08-22): replaces the previous direct LinkedIn/Naukri
# scrapers, both flagged in Sessions 35-37 for real legal/technical risk
# (User-Agent spoofing; an undocumented, likely-broken internal API). This
# is a real paid provider — subscribe to "Job Postings API" by Techmap on
# RapidAPI: rapidapi.com/techmap-io-techmap-io-default/api/daily-international-job-postings
# Free BASIC tier: 100 requests/month, up to 1,000 job postings/month.
# Without this set, LinkedIn/Naukri results are silently empty for paid-
# plan users (fails soft, same as every other optional source here) — it
# does not affect free-plan users, since these two sources are gated to
# paid plans only (see plans.config.js).
# TECHMAP_RAPIDAPI_KEY=your_rapidapi_key

# ─── Apify Cloud Scraping — LinkedIn & Naukri (optional, paid-plan source) ───
# Bypasses bot detection and anti-scraping blocks through Apify's managed cloud actors
# and proxy network. Free tier includes $5/month credits at console.apify.com.
# If not set, Apify calls gracefully return [] without blocking or throwing errors.
# APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: override default actor identifiers
# APIFY_LINKEDIN_ACTOR=apify/linkedin-jobs-scraper
# APIFY_NAUKRI_ACTOR=curious_coder/naukri-job-scraper

# ─── Resend — free 3,000 emails/month at resend.com ────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ─── Twilio WhatsApp Sandbox — free at twilio.com ──────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── Stripe — Price IDs must be created in your Stripe Dashboard first ─────────
# (Stripe requires pre-created Price objects; the amounts below are what your
# frontend DISPLAYS via /api/config/plans — make sure they match the actual
# price on each Stripe Price object.)
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_STARTER=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ELITE=price_xxxxxxxxxxxxxxxxxxxx
# The same STRIPE_SECRET_KEY above is also used by the admin coupon system
# (Session 37) — no separate key needed. Without it set, the Admin Panel's
# Coupons tab returns a clear "Stripe not configured" error instead of a
# generic 500.

# ─── Feature flags (Session 37) ────────────────────────────────────────────
# Real, backend-enforced payments/referrals on-off toggles, controlled from
# the Admin Panel (Features tab) — not env vars themselves, stored in
# SystemSetting. This just controls how long the in-memory read-cache for
# those toggles lives before checking the DB again (admin writes invalidate
# it immediately regardless, so this only affects staleness from some other
# write path). Default 30 seconds.
# FEATURE_FLAG_CACHE_TTL_SECONDS=30

# ── Referral program ─────────────────────────────────────────────────────────
# Points credited to the referrer when a referred user completes their FIRST
# paid plan purchase (never on signup alone). REFERRAL_POINT_VALUE is what one
# point is worth in PLAN_CURRENCY when redeemed as a checkout discount.
REFERRAL_POINTS_PER_REFERRAL=100
REFERRAL_POINT_VALUE=1

# ─── Plan Pricing, Limits & Feature Copy ────────────────────────────────────────
# Everything below is optional — sensible defaults are built in (shown as
# comments). Uncomment and edit to change pricing, daily limits, which job
# sources each plan includes, real-time polling speed, trial length, or the
# marketing bullet points shown on /plans, all without touching any code.
# Served publicly (no secrets) via GET /api/config/plans.

PLAN_CURRENCY=INR
PLAN_CURRENCY_SYMBOL=₹

# PLAN_FREE_PRICE=0
# PLAN_FREE_DAILY_LIMIT=3
# PLAN_FREE_SOURCES=remotive,himalayas
# PLAN_FREE_FEATURES=["3 applications/day","Remotive + Himalayas","Basic AI resume parsing","Email notifications"]
# PLAN_FREE_CTA=Get Started Free

# PLAN_STARTER_NAME=Starter
# PLAN_STARTER_PRICE=299
# PLAN_STARTER_DAILY_LIMIT=15
# PLAN_STARTER_SOURCES=remotive,himalayas,adzuna
# PLAN_STARTER_REALTIME=false
# PLAN_STARTER_TRIAL_DAYS=7
# PLAN_STARTER_FEATURES=["15 applications/day","Remotive + Himalayas + Adzuna","AI resume tailoring per job","Email + WhatsApp alerts","7-day free trial"]
# PLAN_STARTER_CTA=Start Free Trial

# PLAN_PRO_NAME=Pro
# PLAN_PRO_PRICE=699
# PLAN_PRO_DAILY_LIMIT=50
# PLAN_PRO_SOURCES=remotive,himalayas,adzuna,arbeitnow
# PLAN_PRO_REALTIME=true
# PLAN_PRO_REALTIME_INTERVAL=120
# PLAN_PRO_TRIAL_DAYS=7
# PLAN_PRO_POPULAR=true
# PLAN_PRO_FEATURES=["50 applications/day","All legal job boards incl. Arbeitnow","Real-time job detection (2 min)","AI resume tailoring per job","Full notifications","7-day free trial"]
# PLAN_PRO_CTA=Go Pro

# PLAN_ELITE_NAME=Elite
# PLAN_ELITE_PRICE=1499
# PLAN_ELITE_DAILY_LIMIT=200
# PLAN_ELITE_SOURCES=remotive,himalayas,adzuna,arbeitnow
# PLAN_ELITE_REALTIME=true
# PLAN_ELITE_REALTIME_INTERVAL=60
# PLAN_ELITE_TRIAL_DAYS=7
# PLAN_ELITE_FEATURES=["200 applications/day","Real-time detection (1 min)","Priority apply queue","Advanced analytics","Priority support","7-day free trial"]
# PLAN_ELITE_CTA=Go Elite

# ─── Ghost Job Detection ─────────────────────────────────────────────────────
# Default minimum legitimacy score (0-100) for a job to be shown/applied to.
# Individual users can override this from their own Preferences page —
# this env var is only the fallback when they haven't set one.
GHOST_JOB_MIN_SCORE=40

# ─── App ────────────────────────────────────────────────────────────────────────
APP_URL=https://your-frontend-domain.com
LOG_LEVEL=info
# Optional — set to true to write Winston logs to backend/logs/combined.log and error.log
# LOG_TO_FILE=true
# Optional — custom directory for server log files (defaults to backend/logs)
# LOG_DIR=./logs

# ─── Groq retry/rate-limit tuning (all optional — safe defaults in code) ────
# Added Session 2 to fix a production 429-rate-limit storm during job
# matching. Only touch these if you upgrade/downgrade your Groq plan tier.
# GROQ_MAX_RETRIES=4
# GROQ_BASE_RETRY_DELAY_MS=1500
# GROQ_MATCH_BATCH_SIZE=5
# GROQ_MATCH_BATCH_DELAY_MS=2000
# GROQ_MATCH_STAGGER_MS=250

# ─── Error alerting ──────────────────────────────────────────────────────────
# Sends an HTML email on every 500-level server error. Runs automatically in
# production; set FORCE_ALERT_EMAIL=true to also enable it in development, or
# FORCE_ALERT_EMAIL=false to silence it even in production.
# ALERT_EMAIL defaults to a hardcoded address in utils/alertMailer.js if unset
# — set this explicitly so alerts go where you actually want them.
ALERT_EMAIL=you@example.com
FORCE_ALERT_EMAIL=false
